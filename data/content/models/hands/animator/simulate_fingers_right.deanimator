<?xml version='1.0' encoding='UTF-8'?>
<animator>
	<display>
		<model>/content/models/hands/right.demodel</model>
		<skin>/content/models/hands/hand.deskin</skin>
		<rig>/content/models/hands/right.derig</rig>
		<locomotion>
		</locomotion>
	</display>
	<rig>../right.derig</rig>
	<animation>grab_poses_right.deanim</animation>
	
	<controller>
		<name>trigger</name>
		<limits min='0' max='1'/>
	</controller>
	
	<controller>
		<name>grab</name>
		<limits min='0' max='1'/>
	</controller>
	
	<link>
		<name>trigger</name>
		<controller>0</controller>
	</link>
	
	<link>
		<name>grab</name>
		<controller>1</controller>
	</link>
	
	<ruleStateManipulator>
		<name>reset</name>
		<positionMinimum x='0' y='0' z='0'/>
		<positionMaximum x='0' y='0' z='0'/>
		<rotationMinimum x='0' y='0' z='0'/>
		<rotationMaximum x='0' y='0' z='0'/>
		<sizeMinimum x='1' y='1' z='1'/>
		<sizeMaximum x='1' y='1' z='1'/>
		<vertexPositionSetMinimum>0</vertexPositionSetMinimum>
		<vertexPositionSetMaximum>0</vertexPositionSetMaximum>
		<enablePosition>true</enablePosition>
	</ruleStateManipulator>
	
	<ruleAnimation>
		<name>base</name>
		<bone>attachHand.r</bone>
		<bone>origin.r</bone>
		<bone>wrist.r</bone>
		<moveName>grab grip</moveName>
		<moveTime>0</moveTime>
	</ruleAnimation>
	
	<ruleAnimation>
		<name>grab</name>
		<target name='blendFactor'>
			<link>1</link>
		</target>
		<bone>middle1.r</bone>
		<bone>middle2.r</bone>
		<bone>middle3.r</bone>
		<bone>middle4.r</bone>
		<bone>thumb3.r</bone>
		<bone>pinky1.r</bone>
		<bone>pinky2.r</bone>
		<bone>pinky3.r</bone>
		<bone>pinky4.r</bone>
		<bone>ring1.r</bone>
		<bone>ring2.r</bone>
		<bone>ring3.r</bone>
		<bone>ring4.r</bone>
		<bone>thumb1.r</bone>
		<bone>thumb2.r</bone>
		<moveName>grab grip</moveName>
		<moveTime>0</moveTime>
	</ruleAnimation>
	
	<ruleAnimation>
		<name>trigger</name>
		<target name='blendFactor'>
			<link>0</link>
		</target>
		<bone>index1.r</bone>
		<bone>index2.r</bone>
		<bone>index3.r</bone>
		<bone>index4.r</bone>
		<moveName>grab grip</moveName>
		<moveTime>0</moveTime>
	</ruleAnimation>
</animator>
