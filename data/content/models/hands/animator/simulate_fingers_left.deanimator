<?xml version='1.0' encoding='UTF-8'?>
<animator>
	<display>
		<model>/content/models/hands/left.demodel</model>
		<skin>/content/models/hands/hand.deskin</skin>
		<rig>/content/models/hands/left.derig</rig>
		<locomotion>
		</locomotion>
	</display>
	<rig>../left.derig</rig>
	<animation>grab_poses_left.deanim</animation>
	
	<controller>
		<name>trigger</name>
		<limits min='0' max='1'/>
	</controller>
	
	<controller>
		<name>grab</name>
		<limits min='0' max='1'/>
	</controller>
	
	<link>
		<name>trigger</name>
		<controller>0</controller>
	</link>
	
	<link>
		<name>grab</name>
		<controller>1</controller>
	</link>
	
	<ruleStateManipulator>
		<name>reset</name>
		<positionMinimum x='0' y='0' z='0'/>
		<positionMaximum x='0' y='0' z='0'/>
		<rotationMinimum x='0' y='0' z='0'/>
		<rotationMaximum x='0' y='0' z='0'/>
		<sizeMinimum x='1' y='1' z='1'/>
		<sizeMaximum x='1' y='1' z='1'/>
		<vertexPositionSetMinimum>0</vertexPositionSetMinimum>
		<vertexPositionSetMaximum>0</vertexPositionSetMaximum>
	</ruleStateManipulator>
	
	<ruleAnimation>
		<name>base</name>
		<bone>attachHand.l</bone>
		<bone>origin.l</bone>
		<bone>wrist.l</bone>
		<moveName>grab grip</moveName>
		<moveTime>0</moveTime>
	</ruleAnimation>
	
	<ruleAnimation>
		<name>grab</name>
		<target name='blendFactor'>
			<link>1</link>
		</target>
		<bone>middle1.l</bone>
		<bone>middle2.l</bone>
		<bone>middle3.l</bone>
		<bone>middle4.l</bone>
		<bone>thumb3.l</bone>
		<bone>pinky1.l</bone>
		<bone>pinky2.l</bone>
		<bone>pinky3.l</bone>
		<bone>pinky4.l</bone>
		<bone>ring1.l</bone>
		<bone>ring2.l</bone>
		<bone>ring3.l</bone>
		<bone>ring4.l</bone>
		<bone>thumb1.l</bone>
		<bone>thumb2.l</bone>
		<moveName>grab grip</moveName>
		<moveTime>0</moveTime>
	</ruleAnimation>
	
	<ruleAnimation>
		<name>trigger</name>
		<target name='blendFactor'>
			<link>0</link>
		</target>
		<bone>index1.l</bone>
		<bone>index2.l</bone>
		<bone>index3.l</bone>
		<bone>index4.l</bone>
		<moveName>grab grip</moveName>
		<moveTime>0</moveTime>
	</ruleAnimation>
</animator>
