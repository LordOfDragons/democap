		<motionTransfer type="autoHuman">
			<name>Automatic Human</name>
			<enable>true</enable>
			<boneHead>Head</boneHead>
			<boneChest>Spine3</boneChest>
			<boneHandRight>Hand.R</boneHandRight>
			<boneHandLeft>Hand.L</boneHandLeft>
			<boneHip>Hip</boneHip>
			<boneFootRight>Feet.R</boneFootRight>
			<boneFootLeft>Feet.L</boneFootLeft>
			<bendShapeSpine>0.65</bendShapeSpine>
			<bendShapeNeck>0.65</bendShapeNeck>
			<moveBaseIK>baseik</moveBaseIK>
			<moveCrouch>crouch</moveCrouch>
			<reachScalingArmRight x="1" y="1.1" z="0.9"/>
			<reachScalingArmRightBack x="0.3" y="0.8" z="1"/>
			<reachScalingArmLeft x="1" y="1.1" z="0.9"/>
			<reachScalingArmLeftBack x="0.3" y="0.8" z="1"/>
			<scaleHeadRotation x="1" y="1" z="2"/>
			<scaleSpineBending x="1" y="1" z="1"/>
			<neckBendAxisRotation x="90" y="0" z="0"/>
			<spineBendAxisRotation x="90" y="0" z="0"/>
			<relocateArms>true</relocateArms>
			<waistMode>direct</waistMode>
			<pullFeetToGround>true</pullFeetToGround>
			<simulateWaist>true</simulateWaist>
			<useSpineTwist>true</useSpineTwist>
			<neckBendMoveX>look.updown</neckBendMoveX>
			<neckBendMoveY/>
			<neckBendMoveRange x="60" y="45"/>
			<neckShiftMoveX>head.shift.forthback</neckShiftMoveX>
			<neckShiftMoveY/>
			<neckShiftMoveRange x="20" y="12"/>
			<shoulderRange x="30" y="45"/>
			<elbowGuideUsePosition>false</elbowGuideUsePosition>
			<useShoulderRotation>true</useShoulderRotation>
		</motionTransfer>
		<motionTransfer type="fingers">
			<name>Fingers Right</name>
			<enable>true</enable>
			<thumbTipBone/>
			<thumbBaseBone/>
			<indexTipBone>HandIndex3.R</indexTipBone>
			<indexBaseBone>HandIndex1.R</indexBaseBone>
