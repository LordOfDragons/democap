			<pinkyTipBone/>
			<pinkyBaseBone/>
			<wristBone>Hand.R</wristBone>
			<tracker>Right Hand Controller</tracker>
			<bendAngle>85</bendAngle>
			<moveHandsClosed>claws.closed</moveHandsClosed>
			<thumbRotation x="0" y="-90" z="0"/>
