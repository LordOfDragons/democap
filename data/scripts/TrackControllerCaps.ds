namespace Democap

pin Dragengine.Commands
pin Dragengine.Scenery

pin Democap.Actions
pin Democap.Elements


/**
 * Track hand controller capabilities.
 */
class TrackControllerCaps extends DefaultBindingManagerListener
	var bool pHasControllerLeft, pHasControllerRight
	var bool pHasTouchTrackPadLeft, pHasTouchTrackPadRight
	var bool pHasTouchMenuLeft, pHasTouchMenuRight
	var bool pHasTouchSecondaryLeft, pHasTouchSecondaryRight
	var bool pHasTouchThumbrestLeft, pHasTouchThumbrestRight
	var bool pHasTouchStickLeft, pHasTouchStickRight
	var bool pEnableTouch
	
	
	func new()
		// pEnableTouch = true
	end
	
	
	func bool getEnableTouch()
		return pEnableTouch
	end
	
	func void setEnableTouch(bool enable)
		pEnableTouch = enable
	end
	
	
	func bool getHasControllerLeft()
		return pHasControllerLeft
	end
	
	func bool getHasControllerRight()
		return pHasControllerRight
	end
	
	func bool getHasTouchTrackPadLeft()
		return pHasTouchTrackPadLeft
	end
	
	func bool getHasTouchTrackPadRight()
		return pHasTouchTrackPadRight
	end
	
	func bool getHasTouchMenuLeft()
		return pHasTouchMenuLeft
	end
	
	func bool getHasTouchMenuRight()
		return pHasTouchMenuRight
	end
	
	func bool getHasTouchSecondaryLeft()
		return pHasTouchSecondaryLeft
	end
	
	func bool getHasTouchSecondaryRight()
		return pHasTouchSecondaryRight
	end
	
	func bool getHasTouchThumbrestLeft()
		return pHasTouchThumbrestLeft
	end
	
	func bool getHasTouchThumbrestRight()
		return pHasTouchThumbrestRight
	end
	
	func bool getHasTouchStickLeft()
		return pHasTouchStickLeft
	end
	
	func bool getHasTouchStickRight()
		return pHasTouchStickRight
	end
	
	func bool hasAnyTouchButtonsLeft()
		return pEnableTouch and (pHasTouchTrackPadLeft or pHasTouchMenuLeft or pHasTouchSecondaryLeft or pHasTouchStickLeft)
	end
	
	func bool hasAnyTouchButtonsRight()
		return pEnableTouch and (pHasTouchTrackPadRight or pHasTouchMenuRight or pHasTouchSecondaryRight or pHasTouchStickRight)
	end
	
	
	func void deviceAttached(BindingManager manager, InputDevice device)
		updateCapabilities(manager)
	end
	
	func void deviceDetached(BindingManager manager, InputDevice device)
		updateCapabilities(manager)
	end
	
	func void devicesReloaded(BindingManager manager)
		updateCapabilities(manager)
	end
	
	
	func void updateCapabilities(BindingManager manager)
		pHasControllerLeft = false
		pHasControllerRight = false
		pHasTouchTrackPadLeft = false
		pHasTouchTrackPadRight = false
		pHasTouchMenuLeft = false
		pHasTouchMenuRight = false
		pHasTouchSecondaryLeft = false
		pHasTouchSecondaryRight = false
		pHasTouchThumbrestLeft = false
		pHasTouchThumbrestRight = false
		pHasTouchStickLeft = false
		pHasTouchStickRight = false
		
		manager.forEachDevice(block InputDevice device
			select device.getType()
			case InputDeviceType.vrLeftHand
				pHasControllerLeft = true
				pHasTouchTrackPadLeft = hasTouchButton(device, InputDeviceButtonType.touchPad, 0)
				pHasTouchMenuLeft = hasTouchButton(device, InputDeviceButtonType.action, 0)
				pHasTouchSecondaryLeft = hasTouchButton(device, InputDeviceButtonType.action, 1)
				pHasTouchThumbrestLeft = hasTouchButton(device, InputDeviceButtonType.thumbrest, 0)
				pHasTouchStickLeft = hasTouchButton(device, InputDeviceButtonType.stick, 0)
				
			case InputDeviceType.vrRightHand
				pHasControllerRight = true
				pHasTouchTrackPadRight = hasTouchButton(device, InputDeviceButtonType.touchPad, 0)
				pHasTouchMenuRight = hasTouchButton(device, InputDeviceButtonType.action, 0)
				pHasTouchSecondaryRight = hasTouchButton(device, InputDeviceButtonType.action, 1)
				pHasTouchThumbrestRight = hasTouchButton(device, InputDeviceButtonType.thumbrest, 0)
				pHasTouchStickRight = hasTouchButton(device, InputDeviceButtonType.stick, 0)
			end
		end)
		
		// notify
		var WorldSpawnCharacter wsc = GameApp.getGameApp().getWorldSpawnCharacter()
		if wsc == null
			return
		end
		
		var MoCapActor player = wsc.getActor()
		if player == null
			return
		end
		
		var BaseActorAction action = player.getAIAction().getAction()
		if action != null and action castable AAControlCommands
			(action cast AAControlCommands).controllerCapabilitiesChanged()
		end
	end
	
	protected func bool hasTouchButton(InputDevice device, InputDeviceButtonType buttonType, int index)
		if device != null
			var int i, count = device.getButtonCount()
			var InputDeviceButton button
			
			for i = 0 to count
				button = device.getButtonAt(i)
				if button.getType() == buttonType and index-- == 0
					return button.getTouchable()
				end
			end
		end
		return false
	end
end
