namespace Democap.Gui

pin Democap.Behaviors
pin Democap.Characters
pin Democap.MotionTransferSystem

pin Dragengine.Gui.Layouts
pin Dragengine.Gui.Events
pin Dragengine.Scenery


/**
 * Tweak panel motion transfer.
 */
class WMPPTMTIK extends WMPPMotionTransfer
	class ReachScalingChanged implements ActionListener
		protected var WMPPTMTIK pPanel
		
		func new(WMPPTMTIK panel)
			pPanel = panel
		end
		
		func void onAction(ActionEvent event)
			pPanel.onReachScalingChanged()
		end
	end
	
	class ReachScalingBackChanged implements ActionListener
		protected var WMPPTMTIK pPanel
		
		func new(WMPPTMTIK panel)
			pPanel = panel
		end
		
		func void onAction(ActionEvent event)
			pPanel.onReachScalingBackChanged()
		end
	end
	
	class RotationOffsetChanged implements ActionListener
		protected var WMPPTMTIK pPanel
		
		func new(WMPPTMTIK panel)
			pPanel = panel
		end
		
		func void onAction(ActionEvent event)
			pPanel.onRotationOffsetChanged()
		end
	end
	
	
	
	
	var WMPPTweakValue pEditReachScalingX, pEditReachScalingY, pEditReachScalingZ
	var WMPPTweakValue pEditReachScalingBackX, pEditReachScalingBackY, pEditReachScalingBackZ
	var WMPPTweakValue pEditRotationOffsetX, pEditRotationOffsetY, pEditRotationOffsetZ
	
	
	
	/** Create panel. */
	func new(WMPPanelTweaking panelTweaking) super(panelTweaking)
		pModelTypeName.setText("@UI.InverseKinematic")
		
		runWhileBlockingLayout(block
			createContent()
		end)
	end
	
	/** Dispose of panel. */
	func void dispose()
		pEditReachScalingX = null
		pEditReachScalingY = null
		pEditReachScalingZ = null
		pEditReachScalingBackX = null
		pEditReachScalingBackY = null
		pEditReachScalingBackZ = null
		pEditRotationOffsetX = pEditRotationOffsetY = pEditRotationOffsetZ = null
		super.dispose()
	end
	
	
	
	func void onTweaked()
		if pMotionTransfer == null
			return
		end
		
		runWhileBlockingLayout(block
			var MotionTransferIK mt = pMotionTransfer cast MotionTransferIK
			
			var Vector v = mt.getReachScaling()
			pEditReachScalingX.setValue(v.getX())
			pEditReachScalingY.setValue(v.getY())
			pEditReachScalingZ.setValue(v.getZ())
			
			v = mt.getReachScalingBack()
			pEditReachScalingBackX.setValue(v.getX())
			pEditReachScalingBackY.setValue(v.getY())
			pEditReachScalingBackZ.setValue(v.getZ())
			
			v = mt.getRotationOffset()
			pEditRotationOffsetX.setValue(v.getX())
			pEditRotationOffsetY.setValue(v.getY())
			pEditRotationOffsetZ.setValue(v.getZ())
		end)
		doLayoutIfBlocked()
	end
	
	func void onReachScalingChanged()
		var MotionTransferIK mt = pMotionTransfer cast MotionTransferIK
		if mt != null
			var Vector v = Vector.new(pEditReachScalingX.getValue(),\
				pEditReachScalingY.getValue(), pEditReachScalingZ.getValue())
			if not mt.getReachScaling().equals(v)
				mt.setReachScaling(v)
				mt.tweaked()
				pPanelTweaking.notifyCharacterTweaked()
			end
		end
	end
	
	func void onReachScalingBackChanged()
		var MotionTransferIK mt = pMotionTransfer cast MotionTransferIK
		if mt != null
			var Vector v = Vector.new(pEditReachScalingBackX.getValue(),\
				pEditReachScalingBackY.getValue(), pEditReachScalingBackZ.getValue())
			if not mt.getReachScalingBack().equals(v)
				mt.setReachScalingBack(v)
				mt.tweaked()
				pPanelTweaking.notifyCharacterTweaked()
			end
		end
	end
	
	func void onRotationOffsetChanged()
		var MotionTransferIK mt = pMotionTransfer cast MotionTransferIK
		if mt != null
			var Vector v = Vector.new(pEditRotationOffsetX.getValue(),\
				pEditRotationOffsetY.getValue(), pEditRotationOffsetZ.getValue())
			if not mt.getRotationOffset().equals(v)
				mt.setRotationOffset(v)
				mt.tweaked()
				pPanelTweaking.notifyCharacterTweaked()
			end
		end
	end
	
	/** Supports motion transfer type. */
	func bool supports(MotionTransfer motionTranfer)
		return motionTranfer castable MotionTransferIK
	end
	
	
	
	/** Create window content. */
	protected func void createContent()
		var Label label
		var String toolTip
		
		createBaseContent("pct_ik")
		
		// reach scaling
		var ReachScalingChanged action = ReachScalingChanged.new(this)
		
		toolTip = "@UI.ToolTip.ReachScalingTwistAxis"
		
		label = Label.new("@UI.ReachScaling.Label", "Label.FormCaption.SingleLine")
		label.setToolTip(toolTip)
		pPanelForm.addWidget(label)
		pPanelForm.addWidget(Widget.new())
		
		label = Label.new("@UI.X.Label", "Label.FormCaption.SingleLine")
		label.setToolTip(toolTip)
		pPanelForm.addWidget(label)
		
		pEditReachScalingX = WMPPTweakValue.new(4, 0.001, 0.01, 0.1, 1, action)
		pPanelForm.addWidget(pEditReachScalingX)
		
		label = Label.new("@UI.Y.Label", "Label.FormCaption.SingleLine")
		label.setToolTip(toolTip)
		pPanelForm.addWidget(label)
		
		pEditReachScalingY = WMPPTweakValue.new(4, 0.001, 0.01, 0.1, 1, action)
		pPanelForm.addWidget(pEditReachScalingY)
		
		label = Label.new("@UI.Z.Label", "Label.FormCaption.SingleLine")
		label.setToolTip(toolTip)
		pPanelForm.addWidget(label)
		
		pEditReachScalingZ = WMPPTweakValue.new(4, 0.001, 0.01, 0.1, 1, action)
		pPanelForm.addWidget(pEditReachScalingZ)
		
		// reach scaling backwards
		var ReachScalingBackChanged action2 = ReachScalingBackChanged.new(this)
		
		toolTip = "@UI.ToolTip.ReachScalingTwistAxisBack"
		
		label = Label.new("@UI.ReachScalingBack.Label", "Label.FormCaption.SingleLine")
		label.setToolTip(toolTip)
		pPanelForm.addWidget(label)
		pPanelForm.addWidget(Widget.new())
		
		label = Label.new("@UI.X.Label", "Label.FormCaption.SingleLine")
		label.setToolTip(toolTip)
		pPanelForm.addWidget(label)
		
		pEditReachScalingBackX = WMPPTweakValue.new(4, 0.001, 0.01, 0.1, 1, action2)
		pPanelForm.addWidget(pEditReachScalingBackX)
		
		label = Label.new("@UI.Y.Label", "Label.FormCaption.SingleLine")
		label.setToolTip(toolTip)
		pPanelForm.addWidget(label)
		
		pEditReachScalingBackY = WMPPTweakValue.new(4, 0.001, 0.01, 0.1, 1, action2)
		pPanelForm.addWidget(pEditReachScalingBackY)
		
		label = Label.new("@UI.Z.Label", "Label.FormCaption.SingleLine")
		label.setToolTip(toolTip)
		pPanelForm.addWidget(label)
		
		pEditReachScalingBackZ = WMPPTweakValue.new(4, 0.001, 0.01, 0.1, 1, action2)
		pPanelForm.addWidget(pEditReachScalingBackZ)
		
		// rotation offset
		var RotationOffsetChanged action3 = RotationOffsetChanged.new(this)
		
		toolTip = "@UI.ToolTip.RotationOffset"
		
		label = Label.new("@UI.RotationOffset.Label", "Label.FormCaption.SingleLine")
		label.setToolTip(toolTip)
		pPanelForm.addWidget(label)
		pPanelForm.addWidget(Widget.new())
		
		label = Label.new("@UI.X.Label", "Label.FormCaption.SingleLine")
		label.setToolTip(toolTip)
		pPanelForm.addWidget(label)
		
		pEditRotationOffsetX = WMPPTweakValue.new(1, 0.1, 1, 10, 0, action3)
		pPanelForm.addWidget(pEditRotationOffsetX)
		
		label = Label.new("@UI.Y.Label", "Label.FormCaption.SingleLine")
		label.setToolTip(toolTip)
		pPanelForm.addWidget(label)
		
		pEditRotationOffsetY = WMPPTweakValue.new(1, 0.1, 1, 10, 0, action3)
		pPanelForm.addWidget(pEditRotationOffsetY)
		
		label = Label.new("@UI.Z.Label", "Label.FormCaption.SingleLine")
		label.setToolTip(toolTip)
		pPanelForm.addWidget(label)
		
		pEditRotationOffsetZ = WMPPTweakValue.new(1, 0.1, 1, 10, 0, action3)
		pPanelForm.addWidget(pEditRotationOffsetZ)
	end
end
