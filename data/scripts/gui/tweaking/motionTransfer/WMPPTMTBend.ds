namespace Democap.Gui
pin Democap.Behaviors
pin Democap.Characters
pin Democap.MotionTransferSystem
pin Dragengine.Gui.Layouts
pin Dragengine.Gui.Events
pin Dragengine.Scenery


/**
 * Tweak panel motion transfer.
 */
class WMPPTMTBend extends WMPPMotionTransfer
	class BendOffsetChanged implements ActionListener
		protected var WMPPTMTBend pPanel
		
		func new(WMPPTMTBend panel)
			pPanel = panel
		end
		
		func void onAction(ActionEvent event)
			pPanel.onBendOffsetChanged()
		end
	end
	
	
	var WMPPTweakValue pEditBendOffsetX, pEditBendOffsetY
	
	
	/** Create panel. */
	func new(WMPPanelTweaking panelTweaking) super(panelTweaking)
		pModelTypeName.setText("@UI.BendBoneChain")
		
		runWhileBlockingLayout(block
			createContent()
		end)
	end
	
	func void dispose()
		pEditBendOffsetX = pEditBendOffsetY = null
		super.dispose()
	end
	
	
	func void onTweaked()
		if pMotionTransfer == null
			return
		end
		
		runWhileBlockingLayout(block
			var MotionTransferBend mt = pMotionTransfer cast MotionTransferBend
			
			var Vector2 v = mt.getBendOffset()
			pEditBendOffsetX.setValue(v.getX())
			pEditBendOffsetY.setValue(v.getY())
		end)
		doLayoutIfBlocked()
	end
	
	func void onBendOffsetChanged()
		var MotionTransferBend mt = pMotionTransfer cast MotionTransferBend
		if mt != null
			var Vector2 v = mt.getBendOffset()
			var float x = pEditBendOffsetX.getValue()
			var float y = pEditBendOffsetY.getValue()
			
			if DEMath.fabs(x - v.getX()) > 0.0001 or DEMath.fabs(y - v.getY()) > 0.0001
				mt.setBendOffset(Vector2.new(x, y))
				mt.tweaked()
				pPanelTweaking.notifyCharacterTweaked()
			end
		end
	end
	
	/** Supports motion transfer type. */
	func bool supports(MotionTransfer motionTranfer)
		return motionTranfer castable MotionTransferBend
	end
	
	
	/** Create window content. */
	protected func void createContent()
		var Label label
		var String toolTip
		
		createBaseContent("motiontransferbend")
		
		// bend offset
		var BendOffsetChanged action = BendOffsetChanged.new(this)
		
		toolTip = "@UI.ToolTip.BendOffset"
		
		label = Label.new("@UI.BendOffset.Label", "Label.FormCaption.SingleLine")
		label.setToolTip(toolTip)
		pPanelForm.addWidget(label)
		pPanelForm.addWidget(Widget.new())
		
		label = Label.new("@UI.X.Label", "Label.FormCaption.SingleLine")
		label.setToolTip(toolTip)
		pPanelForm.addWidget(label)
		
		pEditBendOffsetX = WMPPTweakValue.new(1, 0.1, 1, 10, 0, action)
		pPanelForm.addWidget(pEditBendOffsetX)
		
		label = Label.new("@UI.Y.Label", "Label.FormCaption.SingleLine")
		label.setToolTip(toolTip)
		pPanelForm.addWidget(label)
		
		pEditBendOffsetY = WMPPTweakValue.new(1, 0.1, 1, 10, 0, action)
		pPanelForm.addWidget(pEditBendOffsetY)
	end
end
