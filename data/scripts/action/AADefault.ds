namespace Democap.Actions
pin Democap.Behaviors
pin Democap.Elements
pin Dragengine.LoadSave
pin Dragengine.Preloading
pin Dragengine.Scenery
pin Dragengine.Utils
pin Dragengine.Gui


/**
 * Default BaseVRActor action. Used when the character is spawned in the world but no
 * particular action is running. This is the default action characters spawn with.
 */
class AADefault extends AABase
	/** Factory for loading actor actions. */
	class Factory implements PersistencyFactory, ECBehaviorActorAIAction.ActionFactory
		public static fixed var String name = "AADefault"
		
		func new()
		end
		
		func Persistable readObjectFromFile(PersistencyEnvironment env, FileReader reader)
			return AADefault.new()
		end
		
		public static func void registerFactory(Persistency persistency)
			persistency.addFactory(name, Factory.new())
		end
		
		func BaseActorAction createAction(ECBehaviorActorAIAction.Instance instance)
			return AADefault.new()
		end
	end
	
	/** Show laser on touch setting changed. */
	class ShowLaserComponentChanged extends DefaultListModelListener
		var AADefault pAction
		
		func new(AADefault action)
			pAction = action
		end
		
		func void valueChanged(ListModel listModel)
			pAction.updateTrackTouchComponent()
		end
	end
	
	
	protected var ECBAControlDesktop.Instance controlDesktop
	protected var ECBAInteractHandle.Instance interactHandle
	protected var ECBAGrab.Instance grabRightHand, grabLeftHand
	protected var ECBASelectable.Instance actorSelectable
	protected var ECBehaviorVRHud.Instance vrHud
	protected var ECBAResetCalibrationWatcher.Instance resetCalibrationWatcher
	protected var SessionSettings.ShowLaserComponent pShowLaserOnTouchLeft, pShowLaserOnTouchRight
	protected var ShowLaserComponentChanged pShowLaserOnTouchListener
	
	
	/** Create action. */
	func new()
	end
	
	
	
	/** Init behaviors. */
	protected func void initBehaviors()
		super.initBehaviors()
		
		var MoCapActor mcactor = actor cast MoCapActor
		controlDesktop = mcactor.controlDesktop
		interactHandle = mcactor.interactHandle
		grabRightHand = mcactor.grabRightHand
		grabLeftHand = mcactor.grabLeftHand
		actorSelectable = mcactor.actorSelectable
		vrHud = mcactor.vrHud
		resetCalibrationWatcher = mcactor.resetCalibrationWatcher
	end
	
	
	
	/** Action has been activated. */
	func void activate(BehaviorElement actor)
		super.activate(actor)
		
		resetCalibrationWatcher.reset()
		grabRightHand.getGrabber().setEnabled(true)
		grabLeftHand.getGrabber().setEnabled(true)
		
		updateTrackTouchComponent()
		
		pShowLaserOnTouchListener = ShowLaserComponentChanged.new(this)
		SessionSettings.get().getModelShowLaserOnTouch().addListener(pShowLaserOnTouchListener)
	end
	
	/** Action has been deactivated. */
	func void deactivate()
		if pShowLaserOnTouchListener != null
			SessionSettings.get().getModelShowLaserOnTouch().removeListener(pShowLaserOnTouchListener)
			pShowLaserOnTouchListener = null
		end
		
		resetCalibrationWatcher.reset()
		super.deactivate()
	end
	
	/** Update track touch components. */
	func void updateTrackTouchComponent()
		var TrackControllerCaps caps = GameApp.getGameApp().getTrackControllerCaps()
		
		pShowLaserOnTouchLeft = pShowLaserOnTouchRight = SessionSettings.ShowLaserComponent.always
		
		select SessionSettings.get().getShowLaserOnTouch()
		case SessionSettings.ShowLaserComponent.trackPad
			if caps.getHasControllerRight() and caps.getHasTouchTrackPadRight()
				pShowLaserOnTouchRight = SessionSettings.ShowLaserComponent.trackPad
			end
			if caps.getHasControllerLeft() and caps.getHasTouchTrackPadLeft()
				pShowLaserOnTouchLeft = SessionSettings.ShowLaserComponent.trackPad
			end
			
		case SessionSettings.ShowLaserComponent.stick
			if caps.getHasControllerRight() and caps.getHasTouchStickRight()
				pShowLaserOnTouchRight = SessionSettings.ShowLaserComponent.stick
			end
			if caps.getHasControllerLeft() and caps.getHasTouchStickLeft()
				pShowLaserOnTouchLeft = SessionSettings.ShowLaserComponent.stick
			end
			
		case SessionSettings.ShowLaserComponent.menu
			if caps.getHasControllerRight() and caps.getHasTouchMenuRight()
				pShowLaserOnTouchRight = SessionSettings.ShowLaserComponent.menu
			end
			if caps.getHasControllerLeft() and caps.getHasTouchMenuLeft()
				pShowLaserOnTouchLeft = SessionSettings.ShowLaserComponent.menu
			end
			
		case SessionSettings.ShowLaserComponent.secondary
			if caps.getHasControllerRight() and caps.getHasTouchSecondaryRight()
				pShowLaserOnTouchRight = SessionSettings.ShowLaserComponent.secondary
			end
			if caps.getHasControllerLeft() and caps.getHasTouchSecondaryLeft()
				pShowLaserOnTouchLeft = SessionSettings.ShowLaserComponent.secondary
			end
			
		case SessionSettings.ShowLaserComponent.thumbrest
			if caps.getHasControllerRight() and caps.getHasTouchThumbrestRight()
				pShowLaserOnTouchRight = SessionSettings.ShowLaserComponent.thumbrest
			end
			if caps.getHasControllerLeft() and caps.getHasTouchThumbrestLeft()
				pShowLaserOnTouchLeft = SessionSettings.ShowLaserComponent.thumbrest
			end
		end
		
		vrRightHandPointAt.setEnabled(pShowLaserOnTouchRight == SessionSettings.ShowLaserComponent.always)
		vrLeftHandPointAt.setEnabled(pShowLaserOnTouchLeft == SessionSettings.ShowLaserComponent.always)
	end
	
	
	
	/** Trigger pulled. */
	func void triggerPull(bool rightHand)
		resetCalibrationWatcher.triggerPulled(rightHand)
		
		if isHandFacingUser(rightHand) and isHandInFrontOfUser(rightHand)
			return
		end
		
		if rightHand
			if grabRightHand.triggerPull()
				
			elif vrRightHandPointAt.hasVRHandPointAtElement()
				pointAtPull(vrRightHandPointAt)
				
			else
				GameApp.getGameApp().getSelectionTracker().clear()
			end
			
		else
			if grabLeftHand.triggerPull()
				
			elif vrLeftHandPointAt.hasVRHandPointAtElement()
				pointAtPull(vrLeftHandPointAt)
				
			else
				GameApp.getGameApp().getSelectionTracker().clear()
			end
		end
	end
	
	/** Trigger released. */
	func void triggerRelease(bool rightHand)
		resetCalibrationWatcher.triggerRelease(rightHand)
		
		if rightHand
			grabRightHand.triggerRelease()
			pointAtRelease(vrRightHandPointAt)
			
		else
			grabLeftHand.triggerRelease()
			pointAtRelease(vrLeftHandPointAt)
		end
	end
	
	
	/** Menu button pressed. */
	func void menuPress(bool rightHand)
		if resetCalibrationWatcher.menuPress(rightHand)
			return
		end
		
		if rightHand
			if grabRightHand.menuPress()
				return
			end
			
		else
			if grabLeftHand.menuPress()
				return
			end
		end
		
		var BehaviorElement vrmenu = GameApp.getGameApp().getWorldSpawnCharacter().getVRMenu()
		if vrmenu == null
			return
		end
		
		var ECBToggleVisibility.Instance toggleVisibility = ECBToggleVisibility.getInstanceIn(vrmenu)
		if toggleVisibility == null
			return
		end
		
		if toggleVisibility.getVisible()
			toggleVisibility.setVisible(false)
			
		else
			aiAction.setAction(AAShowToggleVisible.new(toggleVisibility,\
				rightHand, AAShowToggleVisible.Button.menu))
		end
	end
	
	/** Menu button released. */
	func void menuRelease(bool rightHand)
		resetCalibrationWatcher.menuRelease(rightHand)
		
		if rightHand
			grabRightHand.menuRelease()
			
		else
			grabLeftHand.menuRelease()
		end
	end
	
	func void menuTouch(bool rightHand)
		if rightHand
			if pShowLaserOnTouchRight == SessionSettings.ShowLaserComponent.menu and grabRightHand.allowTrackTouch()
				vrRightHandPointAt.setEnabled(true)
			end
			
		else
			if pShowLaserOnTouchLeft == SessionSettings.ShowLaserComponent.menu and grabLeftHand.allowTrackTouch()
				vrLeftHandPointAt.setEnabled(true)
			end
		end
	end
	
	func void menuUntouch(bool rightHand)
		if rightHand
			if pShowLaserOnTouchRight == SessionSettings.ShowLaserComponent.menu
				vrRightHandPointAt.setEnabled(false)
			end
			
		else
			if pShowLaserOnTouchLeft == SessionSettings.ShowLaserComponent.menu
				vrLeftHandPointAt.setEnabled(false)
			end
		end
	end
	
	
	func void secondaryTouch(bool rightHand)
		if rightHand
			if pShowLaserOnTouchRight == SessionSettings.ShowLaserComponent.secondary and grabRightHand.allowTrackTouch()
				vrRightHandPointAt.setEnabled(true)
			end
			
		else
			if pShowLaserOnTouchLeft == SessionSettings.ShowLaserComponent.secondary and grabLeftHand.allowTrackTouch()
				vrLeftHandPointAt.setEnabled(true)
			end
		end
	end
	
	func void secondaryUntouch(bool rightHand)
		if rightHand
			if pShowLaserOnTouchRight == SessionSettings.ShowLaserComponent.secondary
				vrRightHandPointAt.setEnabled(false)
			end
			
		else
			if pShowLaserOnTouchLeft == SessionSettings.ShowLaserComponent.secondary
				vrLeftHandPointAt.setEnabled(false)
			end
		end
	end
	
	
	func void thumbrestTouch(bool rightHand)
		if rightHand
			if pShowLaserOnTouchRight == SessionSettings.ShowLaserComponent.thumbrest and grabRightHand.allowTrackTouch()
				vrRightHandPointAt.setEnabled(true)
			end
			
		else
			if pShowLaserOnTouchLeft == SessionSettings.ShowLaserComponent.thumbrest and grabLeftHand.allowTrackTouch()
				vrLeftHandPointAt.setEnabled(true)
			end
		end
	end
	
	func void thumbrestUntouch(bool rightHand)
		if rightHand
			if pShowLaserOnTouchRight == SessionSettings.ShowLaserComponent.thumbrest
				vrRightHandPointAt.setEnabled(false)
			end
			
		else
			if pShowLaserOnTouchLeft == SessionSettings.ShowLaserComponent.thumbrest
				vrLeftHandPointAt.setEnabled(false)
			end
		end
	end
	
	
	func void stickTouch(bool rightHand)
		if rightHand
			if pShowLaserOnTouchRight == SessionSettings.ShowLaserComponent.stick and grabRightHand.allowTrackTouch()
				vrRightHandPointAt.setEnabled(true)
			end
			
		else
			if pShowLaserOnTouchLeft == SessionSettings.ShowLaserComponent.stick and grabLeftHand.allowTrackTouch()
				vrLeftHandPointAt.setEnabled(true)
			end
		end
	end
	
	func void stickUntouch(bool rightHand)
		if rightHand
			if pShowLaserOnTouchRight == SessionSettings.ShowLaserComponent.stick
				vrRightHandPointAt.setEnabled(false)
			end
			
		else
			if pShowLaserOnTouchLeft == SessionSettings.ShowLaserComponent.stick
				vrLeftHandPointAt.setEnabled(false)
			end
		end
	end
	
	
	/** Touch track pad. */
	func void trackPadTouch(bool rightHand)
		if rightHand
			if pShowLaserOnTouchRight == SessionSettings.ShowLaserComponent.trackPad and grabRightHand.allowTrackTouch()
				vrRightHandPointAt.setEnabled(true)
			end
			
		else
			if pShowLaserOnTouchLeft == SessionSettings.ShowLaserComponent.trackPad and grabLeftHand.allowTrackTouch()
				vrLeftHandPointAt.setEnabled(true)
			end
		end
	end
	
	/** Untouch track pad. */
	func void trackPadUntouch(bool rightHand)
		if rightHand
			if controlDesktop.getPointAtRight() == vrRightHandPointAt
				controlDesktop.cancel(true)
			end
			if interactHandle.getPointAt() == vrRightHandPointAt
				interactHandle.cancel()
			end
			if pShowLaserOnTouchRight == SessionSettings.ShowLaserComponent.trackPad
				vrRightHandPointAt.setEnabled(false)
			end
			
		else
			if controlDesktop.getPointAtLeft() == vrLeftHandPointAt
				controlDesktop.cancel(false)
			end
			if interactHandle.getPointAt() == vrLeftHandPointAt
				interactHandle.cancel()
			end
			if pShowLaserOnTouchLeft == SessionSettings.ShowLaserComponent.trackPad
				vrLeftHandPointAt.setEnabled(false)
			end
		end
	end
	
	
	/** Grip grab. */
	func void gripGrab(bool rightHand)
		if rightHand
			if vrRightHandPointAt.getEnabled()
			elif grabRightHand.grab()
			end
			
		else
			if vrLeftHandPointAt.getEnabled()
			elif grabLeftHand.grab()
			end
		end
	end
	
	/** Grip ungrab. */
	func void gripUngrab(bool rightHand)
		if rightHand
			grabRightHand.ungrab()
			
		else
			grabLeftHand.ungrab()
		end
	end
	
	
	func void twoFingerPress(bool rightHand, int finger)
		if finger == 3 and isHandFacingUser(rightHand) and isHandInFrontOfUser(rightHand)
			resetCalibrationWatcher.twoFingerPress(rightHand)
			
		else
			super.twoFingerPress(rightHand, finger)
		end
	end
	
	func void twoFingerRelease(bool rightHand, int finger)
		if finger == 3
			resetCalibrationWatcher.twoFingerRelease(rightHand)
			
		else
			super.twoFingerRelease(rightHand, finger)
		end
	end
	
	
	
	/** Player update thinking. */
	func void playerThink(float elapsed)
		super.playerThink(elapsed)
		
		if vrRightHandPointAt.getEnabled()
			pointAt(vrRightHandPointAt)
		end
		if vrLeftHandPointAt.getEnabled()
			pointAt(vrLeftHandPointAt)
		end
		
		var SessionSettings settings = SessionSettings.get()
		playerInputMove.setCanMove(not settings.getTeleportMovement())
		
		checkBeginTeleport()
	end
	
	/** Think. */
	func void think(float elapsed)
		super.think(elapsed)
		
		grabRightHand.updateGrab(elapsed)
		grabLeftHand.updateGrab(elapsed)
	end
	
	/** Post think. */
	func void postThink(float elapsed)
		super.postThink(elapsed)
		
		grabRightHand.updateGrabPostThink()
		grabLeftHand.updateGrabPostThink()
	end
	
	
	
	/** Start teleporting if required. */
	func void checkBeginTeleport()
		if not SessionSettings.get().getTeleportMovement()
			return
		end
		
		var float moveFB = playerInputMove.getAnalogMoveForwardBackwardSticky()
		var float moveLR = playerInputMove.getAnalogMoveLeftRightSticky()
		var float move = Vector2.new(moveLR, moveFB).getLength()
		if move > 0.5
			aiAction.setAction(AATeleport.new())
		end
	end
	
	/** Pointing at element. */
	func void pointAt(ECBehaviorVRHandPointAt.Instance behavior)
		var bool rightHand = vrRightHandPointAt == behavior
		
		// pulled trigger locks action to be used
		if rightHand and controlDesktop.getTriggerPulledRight()
			controlDesktop.pointAt(behavior, true)
			
		elif not rightHand and controlDesktop.getTriggerPulledLeft()
			controlDesktop.pointAt(behavior, false)
			
		elif interactHandle.getTriggerPulled()
			interactHandle.pointAt(behavior)
			
		// try all actions
		elif controlDesktop.pointAt(behavior, rightHand)
		elif interactHandle.pointAt(behavior)
		end
	end
	
	/** Pull trigger on pointed at element. */
	func void pointAtPull(ECBehaviorVRHandPointAt.Instance behavior)
		var bool rightHand = vrRightHandPointAt == behavior
		
		if controlDesktop.pointAtPull(behavior, rightHand)
		elif interactHandle.pointAtPull(behavior)
		elif actorSelectable.pointAtPull(behavior)
		end
	end
	
	/** Release trigger on pointed at element. */
	func void pointAtRelease(ECBehaviorVRHandPointAt.Instance behavior)
		var bool rightHand = vrRightHandPointAt == behavior
		
		if controlDesktop.pointAtRelease(behavior, rightHand)
		elif interactHandle.pointAtRelease(behavior)
		end
	end
	
	
	
	/** Start calibration. Return true if calibration started. */
	func bool startCalibrate()
		if ECBCharacterConfiguration.getInstanceIn(actor) == null
			return false
		end
		
		aiAction.setAction(AACalibrate.new())
		return true
	end
	
	/** Start recording. Return true if recording started. */
	func bool startRecording()
		if ECBCharacterConfiguration.getInstanceIn(actor) == null
			return false
		end
		
		aiAction.setAction(AARecordAnimation.new())
		return true
	end
	
	
	
	/** Name of PersistencyFactory required to load object from file. */
	func String persistencyFactoryName()
		return Factory.name
	end
end
