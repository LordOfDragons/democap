namespace Democap.Behaviors

pin Dragengine.Scenery
pin Dragengine.Preloading
pin Dragengine.LoadSave
pin Democap.Characters
pin Dragengine.Gui
pin Dragengine.Utils


/**
 * Behavior ensuring the element can be interacted with. If rig has no collision shapes a modified
 * rig is created with model collision enabled.
 * 
 * \see https://developer.dragondreams.ch/wiki/doku.php/democap:behavior_ECBEnsureColliderInteractable
 */
class ECBEnsureColliderInteractable extends DefaultECBehavior
	/**
	 * Behavior factory.
	 * 
	 * Automatically assigns these behaviors if present before adding:
	 * - Required: \ref ECBehaviorComponent
	 * 
	 * Example XML element class:
	 * \code{.xml}
	 * <behavior type='ECBehaviorCollider'/>
	 * 
	 * <behavior type='ECBEnsureColliderInteractable'>
	 * </behavior>
	 * \endcode
	 * 
	 * Element class properties added by the behavior can also be set directly inside the tag
	 * be removing the property name prefix and starting with a "." (for exampler ".propertyName").
	 */
	class Factory implements BehaviorFactory
		func new()
		end
		
		func String factoryId()
			return "ECBEnsureColliderInteractable"
		end

		func ECBehavior addBehavior(BehaviorElementClass eclass, String id, Dictionary parameters)
			return ECBEnsureColliderInteractable.new(eclass, ECBehaviorCollider.getBehaviorIn(eclass))
		end
	end
	
	/** Behavior instance. */
	class Instance extends DefaultECBehaviorInstance
		protected var ECBEnsureColliderInteractable pECBehavior
		
		
		func new(ECBEnsureColliderInteractable ecbehavior, BehaviorElement element) super(element)
			pECBehavior = ecbehavior
		end
		
		func void init(StubElement stub)
			var BehaviorElement element = getElement()
			var ECBehaviorCollider.Instance behcol = pECBehavior.collider.instance(element)
			var Collider collider = behcol.getCollider()
			if collider == null
				return
			end
			
			if collider castable ColliderComponent
				var ColliderComponent colcomp = collider cast ColliderComponent
				var Component component = colcomp.getComponent()
				var Rig rig = component.getRig()
				if rig != null and ModifiedRig.rigHasCollisionShapes(rig)
					return
				end
				
				var ModifiedRig modifiedRig = ModifiedRig.new(rig)
				modifiedRig.setModelCollision(true)
				modifiedRig.buildModifiedRig()
				component.setRig(modifiedRig.getModifiedRig())
				
			elif collider castable ColliderVolume
				var ColliderVolume colvol = collider cast ColliderVolume
				if colvol.getShape().getCount() > 0
					return
				end
				
				if behcol.getECBehavior().getComponent() == null
					return
				end
				
				var Component component = behcol.getECBehavior().getComponent().instance(element).getComponent()
				collider.attachStatic(component)
				
				var Model model = component.getModel()
				if model == null
					return
				end
				
				var Vector minext = model.getMinimumExtend(), maxext = model.getMaximumExtend()
				var ShapeList shape = ShapeList.new()
				shape.addBox((minext + maxext) / 2, (maxext - minext) / 2)
				colvol.setShape(shape)
			end
		end
		
		
		func ECBEnsureColliderInteractable getECBehavior()
			return pECBehavior
		end
	end
	
	
	public var ECBehaviorCollider collider
	
	
	func new(BehaviorElementClass eclass, ECBehaviorCollider collider) super(eclass)
		if collider == null
			throw ENullPointer.new("collider")
		end
		
		this.collider = collider
		
		eclass.addBehavior(this)
	end
	
	func void dispose()
		collider = null
		super.dispose()
	end
	
	
	func Instance instance(BehaviorElement element)
		return element.getInstanceAt(getInstanceIndex()) cast Instance
	end
	
	
	func ECBehaviorInstance createInstance(BehaviorElement element)
		return Instance.new(this, element)
	end
end
