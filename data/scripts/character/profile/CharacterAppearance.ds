namespace Democap.Characters

pin Dragengine.Scenery
pin Dragengine.Utils
pin Dragengine.Gui
pin Dragengine.Preloading


/**
 * Appearance of character.
 */
class CharacterAppearance
	var String pPathModel, pPathSkin, pPathRig, pPathAnimation, pPathDefaultSkin
	var Color pDefaultSkinTintColor
	
	var Model pModel
	var Skin pSkin, pDefaultSkin
	var Rig pRig
	var Animation pAnimation
	
	
	/** Create character appearance. */
	func new()
		pPathModel = pPathSkin = pPathRig = pPathAnimation = ""
		pPathDefaultSkin = "/content/materials/default/default.deskin"
		pDefaultSkinTintColor = Color.lightGray
	end
	
	/** Create copy of character appearance. */
	func new(CharacterAppearance appearance)
		pPathModel = appearance.pPathModel
		pPathSkin = appearance.pPathSkin
		pPathRig = appearance.pPathRig
		pPathAnimation = appearance.pPathAnimation
		pPathDefaultSkin = appearance.pPathDefaultSkin
		pDefaultSkinTintColor = appearance.pDefaultSkinTintColor
		
		pModel = appearance.pModel
		pSkin = appearance.pSkin
		pRig = appearance.pRig
		pAnimation = appearance.pAnimation
		pDefaultSkin = appearance.pDefaultSkin
	end
	
	
	/** Path of model resource to use. */
	func String getPathModel()
		return pPathModel
	end
	
	/** Set path of model resource to use. */
	func void setPathModel(String path)
		if path.equals(pPathModel)
			return
		end
		
		pPathModel = path
		pModel = null
	end
	
	/** Path to skin resource to use. */
	func String getPathSkin()
		return pPathSkin
	end
	
	/** Set path of skin resource to use. */
	func void setPathSkin(String path)
		if path.equals(pPathSkin)
			return
		end
		
		pPathSkin = path
		pSkin = null
	end
	
	/** Path to rig resource to use. */
	func String getPathRig()
		return pPathRig
	end
	
	/** Set path of rig resource to use. */
	func void setPathRig(String path)
		if path.equals(pPathRig)
			return
		end
		
		pPathRig = path
		pRig = null
	end
	
	/** Path to animation resource to use. */
	func String getPathAnimation()
		return pPathAnimation
	end
	
	/** Set path of animation resource to use. */
	func void setPathAnimation(String path)
		if path.equals(pPathAnimation)
			return
		end
		
		pPathAnimation = path
		pAnimation = null
	end
	
	/** Path to default skin resource to use for model textures with no texture assigned. */
	func String getPathDefaultSkin()
		return pPathDefaultSkin
	end
	
	/** Set path of default skin resource to use. */
	func void setPathDefaultSkin(String path)
		if path.equals(pPathDefaultSkin)
			return
		end
		
		pPathDefaultSkin = path
		pDefaultSkin = null
	end
	
	/** Default skin tint color to use for model textures with no texture assigned. */
	func Color getDefaultSkinTintColor()
		return pDefaultSkinTintColor
	end
	
	/** Set default skin tint color to use for model textures with no texture assigned. */
	func void setDefaultSkinTintColor(Color color)
		if color == null
			throw ENullPointer.new()
		end
		pDefaultSkinTintColor = color
	end
	
	
	/** Model or null if not loaded yet. */
	func Model getModel()
		return pModel
	end
	
	/** Set model or null if not loaded yet. */
	func void setModel(Model model)
		pModel = model
	end
	
	/** Skin or null if not loaded yet. */
	func Skin getSkin()
		return pSkin
	end
	
	/** Set skin or null if not loaded yet. */
	func void setSkin(Skin skin)
		pSkin = skin
	end
	
	/** Rig or null if not loaded yet. */
	func Rig getRig()
		return pRig
	end
	
	/** Set rig or null if not loaded yet. */
	func void setRig(Rig rig)
		pRig = rig
	end
	
	/** Animation or null if not loaded yet. */
	func Animation getAnimation()
		return pAnimation
	end
	
	/** Set animation or null if not loaded yet. */
	func void setAnimation(Animation animation)
		pAnimation = animation
	end
	
	/** Default skin or null if not loaded yet. */
	func Skin getDefaultSkin()
		return pDefaultSkin
	end
	
	/** Set default skin or null if not loaded yet. */
	func void setDefaultSkin(Skin defaultSkin)
		pDefaultSkin = defaultSkin
	end
	
	
	/** Init element class. */
	func void initElementClass(BaseVRActorClass eclass)
		var ECComposeComponent component = eclass.getComponent().getComponent()
		
		if not pPathModel.empty()
			component.getModel().setPath(pPathModel)
			component.getModel().setModel(pModel)
		end
		
		if not pPathSkin.empty()
			component.getSkin().setPath(pPathSkin)
			component.getSkin().setSkin(pSkin)
		end
		
		if not pPathRig.empty()
			component.getRig().setPath(pPathRig)
			component.getRig().setRig(pRig)
			
			eclass.getCollider().getCollider().getPhysicsType().setEnumeration(CollisionResponse.dynamic)
			eclass.getCollider().getCollider().getLocalGravity().setVector(null)
		end
	end
	
	/** Add texture replacements for unassigned model textures. */
	func void addDefaultTextureReplacements(ECComposeComponent component)
		if pDefaultSkin == null or pModel == null
			return
		end
		
		var TextureReplacementList trl = component.getTextureReplacements().getList()
		var TextureReplacement tr
		var int i, count = pModel.getTextureCount()
		var String name
		
		for i = 0 to count
			name = pModel.getTextureNameAt(i)
			if (pSkin != null and pSkin.indexOfTextureNamed(name) != -1) or trl.hasNamed(name)
				continue
			end
			
			tr = TextureReplacement.new(name)
			tr.setPath(pPathDefaultSkin)
			tr.setSkin(pDefaultSkin)
			tr.setColorTint(pDefaultSkinTintColor)
			trl.add(tr)
		end
	end
	
	/** Add stub textures for unassigned model textures. */
	func void addDefaultStubTextures(StubElement stub)
		if pDefaultSkin == null or pModel == null
			return
		end
		
		var int i, count = pModel.getTextureCount()
		var StubElementTexture stubTexture
		var String name
		
		for i = 0 to count
			name = pModel.getTextureNameAt(i)
			if (pSkin != null and pSkin.indexOfTextureNamed(name) != -1) or stub.getTextureNamed(name) != null
				continue
			end
			
			stubTexture = StubElementTexture.new(name)
			stubTexture.setPathSkin(pPathDefaultSkin)
			stubTexture.setColorTint(pDefaultSkinTintColor)
			stub.addTexture(stubTexture)
		end
	end
end
