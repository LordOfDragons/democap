namespace Democap.MotionTransferSystem
pin Democap.Actors
pin Democap.Behaviors
pin Democap.Characters
pin Dragengine.Animators
pin Dragengine.LoadSave
pin Dragengine.Scenery
pin Dragengine.Utils
pin Dragengine.XML


/**
 * Motion transfer providing a side view camera attached to a bone.
 * 
 * Allows defining a camera attached to the side of the head to allow the motion capture actor
 * to see sidewards for example for reptile type characters. The camera is shown as a small view
 * in the HMD with optional mask blending to blend into the main view.
 */
class MotionTransferSideView extends DefaultMotionTransfer
	/** Factory. */
	class Factory implements MotionTransferFactory
		func new()
		end
		
		func String factoryID()
			return "sideView"
		end
		
		func MotionTransfer createMotionTransfer()
			return MotionTransferSideView.new(factoryID())
		end
		
		func String displayName()
			return "@UI.SideViewCamera"
		end
	end
	
	
	var String pBone
	var Vector pPosition, pRotation
	var Vector2 pHmdPosition
	var float pHmdSize
	var String pMaskImage
	var float pMaskBlending
	var bool pShowInLiveMode
	var float pTransparency
	
	
	/** Create motion transfer. */
	func new(String factoryID) super(factoryID)
		pBone = ""
		pPosition = Vector.new()
		pRotation = Vector.new()
		pHmdPosition = Vector2.new()
		pHmdSize = 0.25
		pMaskImage = ""
		pMaskBlending = 1
		pShowInLiveMode = true
		pTransparency = 1
	end
	
	/** Create copy of motion transfer. */
	func new(MotionTransferSideView transfer) super(transfer)
		pBone = transfer.pBone
		pPosition = transfer.pPosition
		pRotation = transfer.pRotation
		pHmdPosition = transfer.pHmdPosition
		pHmdSize = transfer.pHmdSize
		pMaskImage = transfer.pMaskImage
		pMaskBlending = transfer.pMaskBlending
		pTransparency = transfer.pTransparency
		pShowInLiveMode = transfer.pShowInLiveMode
	end
	
	
	/** Bone name to attach camera to. */
	func String getBone()
		return pBone
	end
	
	/** Set bone name to attach camera to. */
	func void setBone(String bone)
		if bone == null
			throw ENullPointer.new("bone")
		end
		pBone = bone
	end
	
	/** Position relative to bone. */
	func Vector getPosition()
		return pPosition
	end
	
	/** Set position relative to bone. */
	func void setPosition(Vector position)
		if position == null
			throw ENullPointer.new("position")
		end
		pPosition = position
	end
	
	/** Rotation relative to bone. */
	func Vector getRotation()
		return pRotation
	end
	
	/** Set rotation relative to bone. */
	func void setRotation(Vector rotation)
		if rotation == null
			throw ENullPointer.new("rotation")
		end
		pRotation = rotation
	end
	
	/** Position of camera image in HMD. */
	func Vector2 getHmdPosition()
		return pHmdPosition
	end
	
	/** Set position of camera image in HMD. */
	func void setHmdPosition(Vector2 position)
		if position == null
			throw ENullPointer.new("position")
		end
		pHmdPosition = position
	end
	
	/** Size of camera image in HMD. */
	func float getHmdSize()
		return pHmdSize
	end
	
	/** Set size of camera image in HMD. */
	func void setHmdSize(float size)
		pHmdSize = size
	end
	
	/** Mask image path for camera view in HMD. */
	func String getMaskImage()
		return pMaskImage
	end
	
	/** Set mask image path for camera view in HMD. */
	func void setMaskImage(String path)
		if path == null
			throw ENullPointer.new("path")
		end
		pMaskImage = path
	end
	
	/** Mask blending factor (0 to 1). */
	func float getMaskBlending()
		return pMaskBlending
	end
	
	/** Set mask blending factor (0 to 1). */
	func void setMaskBlending(float blending)
		pMaskBlending = DEMath.clamp(blending, 0.0, 1.0)
	end
	
	/** Show camera in live mode. */
	func bool getShowInLiveMode()
		return pShowInLiveMode
	end
	
	/** Transparency factor (0 to 1). */
	func float getTransparency()
		return pTransparency
	end
	
	/** Set transparency factor (0 to 1). */
	func void setTransparency(float transparency)
		pTransparency = DEMath.clamp(transparency, 0.0, 1.0)
	end
	
	/** Set show camera in live mode. */
	func void setShowInLiveMode(bool show)
		pShowInLiveMode = show
	end
	
	
	/** Init element class. */
	func void initElementClass(CharacterConfiguration config, BaseVRActorClass eclass, ModifiedRig modifyRig)
		ECBMotionTransferSideView.new(eclass, this)
	end
	
	/** Create copy of motion transfer. */
	func MotionTransfer createCopy()
		return MotionTransferSideView.new(this)
	end
	
	/** Load from XML. */
	func void load(BaseXmlLoader loader, EasyXMLElement root)
		root.forEachTag(block EasyXMLElement element, String tagName
			if tagName.equals("name")
				setName(element.getFirstCData())
				
			elif tagName.equals("enable")
				setEnabled(element.getFirstCDataBool())
				
			elif tagName.equals("bone")
				setBone(element.getFirstCData())
				
			elif tagName.equals("position")
				setPosition(loader.readVector(element))
				
			elif tagName.equals("rotation")
				setRotation(loader.readVector(element))
				
			elif tagName.equals("hmdPosition")
				setHmdPosition(loader.readVector2(element))
				
			elif tagName.equals("hmdSize")
				setHmdSize(element.getFirstCDataFloat())
				
			elif tagName.equals("maskImage")
				setMaskImage(element.getFirstCData())
				
			elif tagName.equals("maskBlending")
				setMaskBlending(element.getFirstCDataFloat())
				
			elif tagName.equals("showInLiveMode")
				setShowInLiveMode(element.getFirstCDataBool())
				
			elif tagName.equals("transparency")
				setTransparency(element.getFirstCDataFloat())
			end
		end)
	end
	
	/** Save to XML. */
	func void save(BaseXmlLoader loader, EasyXMLElement tag, bool calibrated)
		tag.addDataTag("name", getName())
		tag.addDataTag("enable", getEnabled())
		tag.addDataTag("bone", pBone)
		loader.writeVector(tag.addTag("position"), pPosition)
		loader.writeVector(tag.addTag("rotation"), pRotation)
		loader.writeVector2(tag.addTag("hmdPosition"), pHmdPosition)
		tag.addDataTag("hmdSize", pHmdSize)
		tag.addDataTag("transparency", pTransparency)
		tag.addDataTag("maskImage", pMaskImage)
		tag.addDataTag("maskBlending", pMaskBlending)
		tag.addDataTag("showInLiveMode", pShowInLiveMode)
	end
end
